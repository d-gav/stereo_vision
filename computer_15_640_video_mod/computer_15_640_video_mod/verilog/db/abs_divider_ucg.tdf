FUNCTION alt_u_div_c2f (denominator[9..0], numerator[29..0])
RETURNS ( quotient[29..0], remainder[9..0]);
FUNCTION lpm_abs_0p9 (data[9..0])
RETURNS ( result[9..0]);
FUNCTION lpm_abs_2p9 (data[29..0])
RETURNS ( overflow, result[29..0]);

--synthesis_resources = lut 375 
SUBDESIGN abs_divider_ucg
( 
	denominator[9..0]	:	input;
	numerator[29..0]	:	input;
	quotient[29..0]	:	output;
	remainder[9..0]	:	output;
) 
VARIABLE 
	divider : alt_u_div_c2f;
	my_abs_den : lpm_abs_0p9;
	my_abs_num : lpm_abs_2p9;
	compl_add_quot_result_int[30..0]	:	WIRE;
	compl_add_quot_cin	:	WIRE;
	compl_add_quot_dataa[29..0]	:	WIRE;
	compl_add_quot_datab[29..0]	:	WIRE;
	compl_add_quot_result[29..0]	:	WIRE;
	compl_add_rem_result_int[10..0]	:	WIRE;
	compl_add_rem_cin	:	WIRE;
	compl_add_rem_dataa[9..0]	:	WIRE;
	compl_add_rem_datab[9..0]	:	WIRE;
	compl_add_rem_result[9..0]	:	WIRE;
	diff_signs	: WIRE;
	gnd_wire	: WIRE;
	neg_quot[29..0]	: WIRE;
	neg_rem[9..0]	: WIRE;
	norm_den[9..0]	: WIRE;
	norm_num[29..0]	: WIRE;
	num_sign	: WIRE;
	protect_quotient[29..0]	: WIRE;
	protect_remainder[9..0]	: WIRE;
	vcc_wire	: WIRE;

BEGIN 
	divider.denominator[] = norm_den[];
	divider.numerator[] = norm_num[];
	my_abs_den.data[] = denominator[];
	my_abs_num.data[] = numerator[];
	compl_add_quot_result_int[] = (compl_add_quot_dataa[], compl_add_quot_cin) + (compl_add_quot_datab[], compl_add_quot_cin);
	compl_add_quot_result[] = compl_add_quot_result_int[30..1];
	compl_add_quot_cin = vcc_wire;
	compl_add_quot_dataa[] = (! protect_quotient[]);
	compl_add_quot_datab[] = ( gnd_wire, gnd_wire, gnd_wire, gnd_wire, gnd_wire, gnd_wire, gnd_wire, gnd_wire, gnd_wire, gnd_wire, gnd_wire, gnd_wire, gnd_wire, gnd_wire, gnd_wire, gnd_wire, gnd_wire, gnd_wire, gnd_wire, gnd_wire, gnd_wire, gnd_wire, gnd_wire, gnd_wire, gnd_wire, gnd_wire, gnd_wire, gnd_wire, gnd_wire, gnd_wire);
	compl_add_rem_result_int[] = (compl_add_rem_dataa[], compl_add_rem_cin) + (compl_add_rem_datab[], compl_add_rem_cin);
	compl_add_rem_result[] = compl_add_rem_result_int[10..1];
	compl_add_rem_cin = vcc_wire;
	compl_add_rem_dataa[] = (! protect_remainder[]);
	compl_add_rem_datab[] = ( gnd_wire, gnd_wire, gnd_wire, gnd_wire, gnd_wire, gnd_wire, gnd_wire, gnd_wire, gnd_wire, gnd_wire);
	diff_signs = (numerator[29..29] $ denominator[9..9]);
	gnd_wire = B"0";
	neg_quot[] = compl_add_quot_result[];
	neg_rem[] = compl_add_rem_result[];
	norm_den[] = my_abs_den.result[];
	norm_num[] = my_abs_num.result[];
	num_sign = numerator[29..29];
	protect_quotient[] = divider.quotient[];
	protect_remainder[] = divider.remainder[];
	quotient[] = ((protect_quotient[] & (! diff_signs)) # (neg_quot[] & diff_signs));
	remainder[] = ((protect_remainder[] & (! num_sign)) # (neg_rem[] & num_sign));
	vcc_wire = B"1";
END;
--VALID FILE
