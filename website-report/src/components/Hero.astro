<header id="hero">
	<div class="kicker">Cornell ECE 5760 · Final Project · Spring 2026</div>
	<h1>Real-Time Stereo Vision on the DE1-SoC</h1>
	<p class="soundbite">
		Fast stereo vision for depth perception.
	</p>
	<div class="byline">
		<span>Daniel Teleshevsky <span class="netid">dt532</span></span>
		<span class="sep">·</span>
		<span>Demetri Gavalas <span class="netid">deg273</span></span>
		<span class="sep">·</span>
		<span>Ezra Reiss <span class="netid">er495</span></span>
	</div>
</header>

<style>
	#hero {
		padding: 80px 0 56px;
		border-bottom: 1px solid var(--border);
		margin-bottom: 56px;
	}

	.kicker {
		font-size: 0.78rem;
		color: var(--accent-hot);
		text-transform: uppercase;
		letter-spacing: 0.18em;
		font-weight: 600;
		margin-bottom: 18px;
	}

	#hero h1 {
		margin: 0 0 0.35em;
		max-width: 18ch;
	}

	.soundbite {
		font-family: 'Source Serif 4', serif;
		font-size: 1.35rem;
		font-style: italic;
		color: var(--text-dim);
		max-width: 60ch;
		margin: 0 0 1.5em;
		line-height: 1.4;
	}

	.byline {
		font-size: 0.95rem;
		color: var(--text-dim);
		margin-bottom: 1.5em;
	}

	.sep {
		margin: 0 0.4em;
		color: var(--text-muted);
	}

	.netid {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.82rem;
		color: var(--text-muted);
		margin-left: 0.3em;
	}
</style>
