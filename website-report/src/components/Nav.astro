---
const sections = [
	{ id: 'intro', label: 'Introduction' },
	{ id: 'high-level', label: 'High-Level Design' },
	{ id: 'algorithm', label: 'Algorithm' },
	{ id: 'rectification', label: 'Rectification' },
	{ id: 'software-pathfinding', label: 'Software Pathfinding' },
	{ id: 'hardware', label: 'Hardware Design' },
	{ id: 'memory', label: '· Row-Banked Memory' },
	{ id: 'undistort', label: '· Radial Undistortion' },
	{ id: 'scheduler', label: '· Four-Phase Scheduler' },
	{ id: 'sad-engine', label: '· SAD Engine' },
	{ id: 'hps', label: 'HPS Software' },
	{ id: 'results', label: 'Results' },
	{ id: 'conclusions', label: 'Conclusions' },
	{ id: 'appendix', label: 'Appendix' },
];
---

<aside id="sidenav">
	<div class="brand">
		<div class="brand-dot"></div>
		<div>
			<div class="brand-title">Stereo Vision</div>
			<div class="brand-sub">ECE 5760 · DE1-SoC</div>
		</div>
	</div>
	<nav>
		<ul>
			{sections.map((s) => (
				<li>
					<a href={`#${s.id}`}>{s.label}</a>
				</li>
			))}
		</ul>
	</nav>
	<div class="team">
		<div class="team-label">Team</div>
		<div>Daniel · Demetrios · Ezra</div>
	</div>
</aside>

<style>
	#sidenav {
		position: fixed;
		top: 0;
		left: 0;
		width: 260px;
		height: 100vh;
		background: var(--bg-elev);
		border-right: 1px solid var(--border);
		padding: 28px 22px 20px;
		display: flex;
		flex-direction: column;
		gap: 18px;
		overflow-y: auto;
		z-index: 50;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.brand-dot {
		width: 12px;
		height: 12px;
		background: var(--accent);
		border-radius: 50%;
		box-shadow: 0 0 14px var(--accent-hot);
		flex-shrink: 0;
	}

	.brand-title {
		font-family: 'Source Serif 4', serif;
		font-weight: 600;
		font-size: 1.1rem;
		color: var(--text);
		line-height: 1.1;
	}

	.brand-sub {
		font-size: 0.72rem;
		color: var(--text-muted);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		margin-top: 2px;
	}

	nav {
		flex: 1;
		min-height: 0;
	}

	nav ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	nav li {
		margin: 0;
	}

	nav a {
		display: block;
		padding: 6px 10px;
		font-size: 0.84rem;
		color: var(--text-dim);
		text-decoration: none;
		border-bottom: none;
		border-radius: 6px;
		transition: background 0.15s ease, color 0.15s ease;
	}

	nav a:hover {
		background: var(--accent-soft);
		color: #ffd6d6;
	}

	.team {
		padding-top: 14px;
		border-top: 1px solid var(--border);
		font-size: 0.82rem;
		color: var(--text-dim);
	}

	.team-label {
		font-size: 0.7rem;
		color: var(--text-muted);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		margin-bottom: 4px;
	}

	@media (max-width: 1024px) {
		#sidenav {
			position: relative;
			width: 100%;
			height: auto;
			border-right: none;
			border-bottom: 1px solid var(--border);
			padding: 16px 20px;
		}

		nav ul {
			display: flex;
			flex-wrap: wrap;
			gap: 4px;
		}

		nav a {
			padding: 4px 10px;
			font-size: 0.78rem;
		}

		.team {
			display: none;
		}
	}
</style>
